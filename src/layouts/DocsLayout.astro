---
interface Props {
  title: string;
  description?: string;
  section?: string;
}
const { title, description, section } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — tolstoy.life</title>
    {description && <meta name="description" content={description} />}
    <script defer src="https://cloud.umami.is/script.js" data-website-id="d14153b8-185c-4d89-b793-15bae8056993"></script>
  </head>
  <body>
    <div class="site-header">
      <a class="home" href="/docs/">tolstoy.life / docs</a>
      {section && (
        <span class="breadcrumb">
          <a href="/docs/">Index</a>
          <span>›</span>
          {section}
        </span>
      )}
    </div>
    <main>
      <slot />
    </main>
  </body>
</html>

<style>
  :root {
    --ink: #1e1a17;
    --ink-soft: #4a4038;
    --paper: #faf7f2;
    --rule: #d9d1c5;
    --accent: #6b4423;
    --accent-soft: #8c6a4a;
    --measure: 38rem;
    --measure-wide: 52rem;
  }

  *, *::before, *::after { box-sizing: border-box; }

  html { font-size: 125%; -webkit-text-size-adjust: 100%; }

  body {
    margin: 0;
    padding: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: "Iowan Old Style", "Palatino Linotype", Palatino, "URW Palladio L", P052, Charter, Georgia, "Times New Roman", serif;
    font-size: 1.05rem;
    line-height: 1.65;
    font-feature-settings: "kern", "liga", "onum";
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  .site-header {
    max-width: var(--measure-wide);
    margin: 0 auto;
    padding: 1.4rem 1.5rem 1rem;
    display: flex;
    align-items: baseline;
    gap: 1.2rem;
    border-bottom: 1px solid var(--rule);
  }

  .site-header a.home {
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-soft);
    text-decoration: none;
    font-style: italic;
    white-space: nowrap;
  }
  .site-header a.home:hover { color: var(--accent); }

  .breadcrumb {
    font-size: 0.82rem;
    color: var(--ink-soft);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .breadcrumb a { color: var(--ink-soft); text-decoration: none; }
  .breadcrumb a:hover { color: var(--accent); text-decoration: underline; }
  .breadcrumb span { color: var(--rule); margin: 0 0.3em; }

  main {
    max-width: var(--measure);
    margin: 0 auto;
    padding: 4rem 1.5rem 6rem;
  }

  section { margin: 3.5rem 0 0; }
  section:first-of-type { margin-top: 2rem; }

  /* markdown content */
  :global(h1) {
    font-size: 2.4rem;
    line-height: 1.15;
    margin: 0 0 1.2rem;
    font-weight: 600;
    letter-spacing: -0.012em;
    color: var(--ink);
  }

  :global(h2) {
    font-size: 1.6rem;
    line-height: 1.25;
    margin: 3rem 0 0.4rem;
    font-weight: 600;
    letter-spacing: -0.005em;
    color: var(--ink);
  }

  :global(h3) {
    font-size: 1.18rem;
    line-height: 1.3;
    margin: 2.4rem 0 0.6rem;
    font-weight: 600;
    color: var(--ink);
  }

  :global(h4) {
    font-size: 1rem;
    font-weight: 600;
    margin: 1.6rem 0 0.4rem;
    color: var(--ink);
  }

  :global(p) {
    margin: 0 0 1.1rem;
    hyphens: auto;
    -webkit-hyphens: auto;
  }

  :global(ol), :global(ul) {
    padding-left: 1.4rem;
    margin: 0 0 1.3rem;
  }

  :global(li) { margin-bottom: 0.6rem; }

  :global(li > ol), :global(li > ul) {
    margin-top: 0.5rem;
    margin-bottom: 0.2rem;
  }

  :global(strong) { font-weight: 600; color: var(--ink); }
  :global(em) { font-style: italic; }

  :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }
  :global(a:hover) { color: var(--ink); }

  :global(code), :global(kbd), :global(samp) {
    font-family: "SF Mono", "Menlo", "Consolas", "Liberation Mono", monospace;
    font-size: 0.88em;
    background: rgba(107, 68, 35, 0.07);
    padding: 0.08em 0.34em;
    border-radius: 2px;
    color: var(--ink);
  }

  :global(pre) {
    background: rgba(107, 68, 35, 0.05);
    border: 1px solid var(--rule);
    border-radius: 3px;
    padding: 1rem 1.2rem;
    overflow-x: auto;
    margin: 0 0 1.4rem;
    font-size: 0.88rem;
    line-height: 1.55;
  }

  :global(pre code) {
    background: none;
    padding: 0;
    font-size: inherit;
  }

  :global(hr) {
    border: 0;
    border-top: 1px solid var(--rule);
    margin: 3rem 0;
  }

  :global(blockquote) {
    margin: 1.4rem 0;
    padding: 0 0 0 1.2rem;
    border-left: 2px solid var(--accent-soft);
    color: var(--ink-soft);
    font-style: italic;
  }

  :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.93rem;
    margin: 0 0 1.4rem;
  }

  :global(th) {
    text-align: left;
    font-weight: 600;
    border-bottom: 2px solid var(--rule);
    padding: 0.4rem 0.6rem;
  }

  :global(td) {
    border-bottom: 1px solid var(--rule);
    padding: 0.4rem 0.6rem;
    vertical-align: top;
  }
</style>
