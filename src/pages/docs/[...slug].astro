---
import { getCollection, render } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

// Derive title from frontmatter or first h1 heading
const title = entry.data.title ?? headings.find(h => h.depth === 1)?.text ?? entry.id;
// Derive section from the first path segment (e.g. "architecture/foo" → "Architecture")
const section = entry.id.includes('/')
  ? entry.id.split('/')[0].replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase())
  : undefined;
---

<DocsLayout title={title} description={entry.data.description} section={section}>
  <Content />
</DocsLayout>
